# ============================================================
# Wallacast backend environment variables (INFRASTRUCTURE ONLY)
#
# Provider API keys (OpenAI, DeepInfra, OpenRouter, Anthropic,
# Gemini) are NOT set here. Each user enters their own keys on the
# in-app Settings page; those keys are encrypted and stored per
# account in the database. This file configures the server and its
# database, nothing about which AI models get called.
# ============================================================

# Database
# Option A: one connection string (simplest for local dev).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallacast
#
# Option B: the discrete variables below (used when DATABASE_URL is unset).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wallacast
DB_USER=postgres
DB_PASSWORD=postgres

# Encryption key for the per-account API keys stored in the database.
# Must be exactly 64 hex characters (32 bytes). If left blank, the
# stored keys fall back to plaintext, which is fine for a local test
# database but must NOT be used in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Secret used to sign login tokens (JWT). If left blank the server
# uses a random secret, which logs everyone out on every restart.
# Generate one the same way as ENCRYPTION_KEY above.
JWT_SECRET=

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
